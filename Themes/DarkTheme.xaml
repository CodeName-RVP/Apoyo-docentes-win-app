<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Color x:Key="AccentColor">#5823C8</Color>
    <Color x:Key="AccentDarkColor">#451A9C</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{DynamicResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="CardBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="BorderBrushLight" Color="#374151" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#85D2FF" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="CheckBoxCheckBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#451A9C" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="ComboDropBorderBrush" Color="#374151" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#111827" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#374151" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowBrushKey}" Color="#111827" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowTextBrushKey}" Color="#F3F4F6" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="#111827" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlTextBrushKey}" Color="#F3F4F6" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="#85D2FF" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="#F3F4F6" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightBrushKey}" Color="#374151" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F3F4F6" />
    <SolidColorBrush x:Key="GridRowBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#111827" />
    <SolidColorBrush x:Key="HighPriorityBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="MediumPriorityBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="LowPriorityBrush" Color="#14532D" />
    <SolidColorBrush x:Key="PriorityForegroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
</ResourceDictionary>


