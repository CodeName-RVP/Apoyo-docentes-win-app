<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Color x:Key="AccentColor">#85D2FF</Color>
    <Color x:Key="AccentDarkColor">#85D2FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{DynamicResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="CardBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="BorderBrushLight" Color="#E5E7EB" />
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#85D2FF" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#85D2FF" />
    <SolidColorBrush x:Key="ButtonHoverForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboHoverBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="ComboDropBorderBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowTextBrushKey}" Color="#111827" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlTextBrushKey}" Color="#111827" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="#85D2FF" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightBrushKey}" Color="#93C5FD" />
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111827" />
    <SolidColorBrush x:Key="GridRowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="HighPriorityBrush" Color="#A7F3D0" />
    <SolidColorBrush x:Key="MediumPriorityBrush" Color="#34D399" />
    <SolidColorBrush x:Key="LowPriorityBrush" Color="#C7D2C1" />
    <SolidColorBrush x:Key="PriorityForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
</ResourceDictionary>


