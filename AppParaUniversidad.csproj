<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="GoogleOAuth.local.props" Condition="Exists('GoogleOAuth.local.props')" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>ApoyoDocentes</AssemblyName>
    <Product>Apoyo Docentes</Product>
    <Version>1.1.0</Version>

    <!-- Publicación para Windows -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Incluir DLL nativas dentro del EXE -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- No generar símbolos de depuración para el paquete final -->
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GoogleClientId Condition="'$(GoogleClientId)' == ''">__GOOGLE_CLIENT_ID__</GoogleClientId>
    <GoogleClientSecret Condition="'$(GoogleClientSecret)' == ''">__GOOGLE_CLIENT_SECRET__</GoogleClientSecret>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.68.0.3427" />
    <PackageReference Include="Google.Apis.Sheets.v4" Version="1.68.0.3476" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Guia de uso.txt">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="CreateProjectShortcut" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$ws = New-Object -ComObject WScript.Shell; $s = $ws.CreateShortcut('$(ProjectDir)Apoyo Docentes.lnk'); $s.TargetPath = '$(TargetDir)$(AssemblyName).exe'; $s.WorkingDirectory = '$(TargetDir)'; $s.IconLocation = '$(TargetDir)$(AssemblyName).exe,0'; $s.Save()&quot;" />
  </Target>

  <Target Name="GenerateGoogleOAuthConfig" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GoogleOAuthConfigFile>$(IntermediateOutputPath)GoogleOAuthConfig.g.cs</GoogleOAuthConfigFile>
    </PropertyGroup>

    <ItemGroup>
      <_GoogleOAuthConfigLines Include="namespace AppParaUniversidad.Services.Google%3B" />
      <_GoogleOAuthConfigLines Include="internal static class GoogleOAuthConfig" />
      <_GoogleOAuthConfigLines Include="{" />
      <_GoogleOAuthConfigLines Include="    public const string ClientId = &quot;$(GoogleClientId)&quot;%3B" />
      <_GoogleOAuthConfigLines Include="    public const string ClientSecret = &quot;$(GoogleClientSecret)&quot;%3B" />
      <_GoogleOAuthConfigLines Include="}" />
    </ItemGroup>

    <WriteLinesToFile
      File="$(GoogleOAuthConfigFile)"
      Lines="@(_GoogleOAuthConfigLines)"
      Overwrite="true"
      Encoding="UTF-8" />

    <ItemGroup>
      <Compile Include="$(GoogleOAuthConfigFile)" />
    </ItemGroup>
  </Target>
</Project>
