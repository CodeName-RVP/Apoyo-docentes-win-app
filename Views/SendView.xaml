<UserControl x:Class="AppParaUniversidad.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="Ciclo:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Ciclo, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,12,0"/>
                    <TextBlock Text="Reenviar a:" Margin="8,0,6,0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AvailableEmails}"
                              SelectedItem="{Binding CcEmail, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Width="220"
                              Margin="0,0,12,0" />
                    <Button Content="Seleccionar validos" Command="{Binding SelectValidCommand}" />
                    <Button Content="Deseleccionar todos" Command="{Binding DeselectAllCommand}" Margin="8,0,0,0" />
                    <Button Content="Enviar" Command="{Binding SendCommand}" Margin="8,0,0,0" />
                    <Button Content="Abrir preview" Click="OnOpenPreviewClick" Margin="8,0,0,0" />
                    <Button Content="Guardar en directorio" Command="{Binding SaveToDirectoryCommand}" Margin="8,0,0,0" />
                </WrapPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Texto de encabezado" />
                        <TextBox Text="{Binding IntroText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="60" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pie de pagina" />
                        <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="60" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding GmailStatus}"
                   FontWeight="SemiBold"
                   Margin="0,4,0,4">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GmailReady}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GmailReady}" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" Padding="6" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Recipients}"
                      SelectedItem="{Binding SelectedRecipient}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding Enviar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Enviar" />
                    <DataGridTextColumn Binding="{Binding NombreVisible}" Header="Docente" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Correo">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding CorreosDisponibles}"
                                          SelectedItem="{Binding Correo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          MinWidth="200" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Binding="{Binding TieneCorreo}" Header="Correo listo" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Mejor sugerencia">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Sugerencias[0], StringFormat='Sugerir: {0}'}"
                                        Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding Sugerencias[0], Converter={StaticResource NullOrEmptyToBoolConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
