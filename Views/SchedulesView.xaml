<UserControl x:Class="AppParaUniversidad.Views.SchedulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Fuente:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource}"
                          Width="150"
                          Margin="0,0,12,0" />
                <Button Content="Cargar archivo" Command="{Binding OpenFileCommand}" IsEnabled="{Binding IsFileSource}" />
                <TextBlock Text="ID Sheet:" VerticalAlignment="Center" Margin="8,0,6,0" />
                <TextBox Text="{Binding GoogleSheetId, UpdateSourceTrigger=PropertyChanged}"
                         Width="260"
                         Margin="0,0,12,0"
                         IsEnabled="{Binding IsGoogleSource}" />
                <TextBlock Text="Historial:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding SheetHistory}"
                          SelectedItem="{Binding SelectedSheetHistory}"
                          DisplayMemberPath="Name"
                          TextSearch.TextPath="Name"
                          IsEditable="True"
                          IsReadOnly="True"
                          Text="{Binding SelectedSheetHistory.Name}"
                          Width="180"
                          Margin="0,0,12,0"
                          IsEnabled="{Binding IsGoogleSource}" />
                <Button Content="Cargar hojas" Command="{Binding LoadGoogleSheetsCommand}" IsEnabled="{Binding IsGoogleSource}" />
                <Button Content="Guardar ID" Command="{Binding ShowSavePromptCommand}" IsEnabled="{Binding IsGoogleSource}" Margin="6,0,0,0" />
                <TextBlock Text="Hoja:" VerticalAlignment="Center" Margin="8,0,6,0" />
                <ComboBox ItemsSource="{Binding SheetNames}"
                          SelectedItem="{Binding SelectedSheet}"
                          Width="220"
                          Margin="0,0,12,0" />
                <Button Content="Analizar" Command="{Binding AnalyzeCommand}" />
                <TextBlock Text="Auto actualizar" VerticalAlignment="Center" Margin="12,0,6,0" />
                <CheckBox IsChecked="{Binding AutoRefreshEnabled}" VerticalAlignment="Center" />
                <TextBlock Text="cada (min):" VerticalAlignment="Center" Margin="8,0,6,0" />
                <ComboBox ItemsSource="{Binding RefreshIntervals}"
                          SelectedItem="{Binding SelectedRefreshInterval}"
                          Width="80"
                          Margin="0,0,12,0" />
                <TextBlock Text="Ultima:" VerticalAlignment="Center" Margin="8,0,6,0" />
                <TextBlock Text="{Binding LastRefreshText}" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,8,0,8">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource DangerBrush}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="0,0,0,8"
                Visibility="{Binding ShowSaveSheetPrompt, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Guardar ID" FontWeight="SemiBold" />
                <TextBlock Text="Ingresa un alias para el ID actual." FontSize="11" Margin="0,4,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SheetNameToSave, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,12,0" />
                    <Button Content="Guardar" Command="{Binding SaveSheetIdCommand}" />
                    <Button Content="Cancelar" Command="{Binding CancelSaveSheetIdCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Buscar docente" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,12,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Docentes" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalTeachers}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Visibles" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VisibleTeachers}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding AverageHours, StringFormat=Promedio: {0:0.##}h}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Seleccion" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTeacherName}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedTeacherTotalHours, StringFormat=Horas: {0:0.##}}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource CardBrush}" Padding="6" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding SchedulesView}"
                          SelectedItem="{Binding SelectedSchedule}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Docente" Binding="{Binding NombreVisible}" Width="*" />
                        <DataGridTextColumn Header="Total (hrs)" Binding="{Binding TotalSemanalHoras, StringFormat=0.##}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource CardBrush}" Padding="10" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Detalle por dia" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding DaySummaries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Day}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RangesText}" />
                                        <TextBlock Text="{Binding Hours, StringFormat=Horas: {0:0.##}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding PreferenceSummary}" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <ListBox ItemsSource="{Binding SelectedPreferences}"
                             MaxHeight="220"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Priority, Converter={StaticResource PriorityToBrushConverter}}"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Subject}" Foreground="{Binding Priority, Converter={StaticResource PriorityToForegroundBrushConverter}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Priority}" Foreground="{Binding Priority, Converter={StaticResource PriorityToForegroundBrushConverter}}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


















