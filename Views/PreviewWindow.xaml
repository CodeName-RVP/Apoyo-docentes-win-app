<Window x:Class="AppParaUniversidad.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa del correo" Height="700" Width="900">
    <Grid Margin="12">
        <Border Background="{DynamicResource CardBrush}" Padding="6" CornerRadius="8" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
            <WebBrowser x:Name="PreviewBrowser" />
        </Border>
    </Grid>
</Window>
