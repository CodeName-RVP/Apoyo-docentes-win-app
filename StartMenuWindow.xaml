<Window x:Class="AppParaUniversidad.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Apoyo Docentes" Height="720" Width="1100" MinHeight="600" MinWidth="900"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Apoyo Docentes" Margin="10,0,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="{DynamicResource IconMinimize}" Width="40" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource TitleBarMaximizeButtonStyle}" Width="40" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="{DynamicResource IconClose}" Width="40" Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="ENTREGA DE HORARIOS A DOCENTES"
                            Padding="20"
                            Margin="25"
                            Width="320"
                            Height="64"
                            Click="OnOpenDeliveryClick" />
                    <Button Content="HORARIOS DOCENTE"
                            Padding="20"
                            Margin="25"
                            Width="320"
                            Height="64"
                            Click="OnOpenTeacherSchedulesClick" />
                </StackPanel>

                <Button Content="Opciones"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="25"
                        Padding="20,10"
                        Click="OnOptionsClick" />

                <TextBlock Text="Version 1.0"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="25"
                           FontSize="12" />
            </Grid>
        </Grid>
    </Border>
</Window>
